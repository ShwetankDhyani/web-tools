[Unit]
Description=WebTools.wiki (Gunicorn)
After=network.target

[Service]
Type=simple
User=setu_dhyani
Group=setu_dhyani
WorkingDirectory=/home/setu_dhyani/web-tools
Environment=PATH=/home/setu_dhyani/web-tools/venv/bin:/usr/local/bin:/usr/bin
Environment=FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
Environment=FLASK_SESSION_SECURE=1
Environment=ADMIN_USERNAME=your_telegram_username
# workers=1 keeps video download progress consistent across requests
ExecStart=/home/setu_dhyani/web-tools/venv/bin/gunicorn app:app --bind 127.0.0.1:8000 --workers 1 --threads 8 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
