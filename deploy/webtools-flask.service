# Flask dev server on port 5000 — matches nginx proxy_pass http://127.0.0.1:5000
[Unit]
Description=WebTools.wiki
After=network.target

[Service]
Type=simple
User=setu_dhyani
Group=setu_dhyani
WorkingDirectory=/home/setu_dhyani/web-tools
Environment=PORT=5000
Environment=FLASK_DEBUG=0
ExecStart=/usr/bin/python3 /home/setu_dhyani/web-tools/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
